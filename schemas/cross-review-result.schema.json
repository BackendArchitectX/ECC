{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecc.tools/schemas/cross-review-result.schema.json",
  "title": "ECC Cross-Review Result v1",
  "description": "Structured, advisory findings returned by an independent reviewer. Findings remain untrusted until verified against repository and executable evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "ecc.review.result.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "no_findings",
        "findings"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "claim",
          "evidenceRefs",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "reliability",
              "performance",
              "architecture",
              "testing",
              "maintainability"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidenceId"
              ],
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "no_findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
