{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecc.tools/schemas/cross-review-request.schema.json",
  "title": "ECC Cross-Review Request v1",
  "description": "Bounded evidence sent to an advisory independent reviewer. The reviewer receives no repository-write or shell authority through this protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "objective",
    "evidence",
    "constraints",
    "trust"
  ],
  "properties": {
    "schema": {
      "const": "ecc.review.request.v1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "plan",
        "diff",
        "failure",
        "final"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "plan",
              "diff",
              "test",
              "failure",
              "context"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFindings"
      ],
      "properties": {
        "maxFindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerAuthority",
        "repositoryWrite",
        "shellAuthority"
      ],
      "properties": {
        "reviewerAuthority": {
          "const": "advisory"
        },
        "repositoryWrite": {
          "const": false
        },
        "shellAuthority": {
          "const": false
        }
      }
    }
  }
}
